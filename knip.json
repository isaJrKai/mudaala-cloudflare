{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/route.ts",
    "src/app/**/page.tsx",
    "src/app/layout.tsx",
    "src/app/api/route.ts",
    "scripts/*.ts",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["examples/**", "mini-services/**", "tests/**", ".zscripts/**"],
  "ignoreDependencies": ["@tailwindcss/postcss", "tw-animate-css", "@types/bun", "bun-types"],
  "next": true
}

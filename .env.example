# Copy to .env and fill real values. NEVER commit the real .env.
# Every value here is a placeholder — the shapes match what CI sets
# (see .github/workflows/ci.yml env block) and what the app expects.
# The app validates this file at startup: in production a missing required
# value refuses to boot (see src/lib/env.ts) instead of failing silently.

# PostgreSQL is the runtime store (Task 5) — local dev and production both
# point at a real Postgres server. Local example: postgresql://mudaala:secret@localhost:5432/mudaala
DATABASE_URL=postgresql://user:password@localhost:5432/mudaala

# Opt-in Prisma query logging (verbose diagnostics). Unset = errors only.
# Every logged query includes its bind parameters (phone numbers, reset
# tokens) — enable only on development/staging machines you control.
# PRISMA_LOG_QUERIES=1

# Photo storage (Task 5). Development leaves these unset and writes photos to
# ./public/uploads. Production sets ALL FOUR (plus the public URL) to switch
# uploads to any S3-compatible bucket (Cloudflare R2, Supabase Storage, MinIO).
#   STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   STORAGE_BUCKET=mudaala-photos
#   STORAGE_KEY=<access-key-id>
#   STORAGE_SECRET=<secret-access-key>
#   STORAGE_PUBLIC_URL=https://cdn.your-domain.example
# STORAGE_REGION is optional (R2/Supabase use "auto" by default).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_PUBLIC_URL=

# Phone numbers (E.164, Uganda +256 only) that get admin powers.
# Required in production — with no allowlist the admin desk fails closed.
ADMIN_PHONES=+256712000001

# Canonical public origin of the deployment. Ad-page URLs, OG tags, the
# sitemap and robots all anchor to it. Required in production.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Shared secret for the cron sweep endpoint (POST /api/cron/sweep).
# The scheduler presents it as the x-cron-secret header. Required in
# production — the endpoint refuses to run without it.
CRON_SECRET=change-me-cron-secret

# Key material for encrypting stored PostgreSQL settings at rest (AES-256-GCM).
# Any string works; a long random hex string is recommended. Required in
# production. SETTINGS_ENC_KEY is the legacy alias and still works.
SETTINGS_ENCRYPTION_KEY=000000000000000000000000000000000000000000000000

# Local/dev convenience: allow Authorization: Bearer session tokens.
# Bearer auth ONLY works when this is truthy; production leaves it unset and
# uses the httpOnly cookie. Legacy alias: AUTH_BEARER_FALLBACK.
ALLOW_BEARER_AUTH=1

# Content-Security-Policy frame-ancestors directive. Default 'self' keeps the
# sandbox/preview iframe working; production deployments should set it to
# "'none'" (no embedding at all) or to the specific parent origin(s) allowed
# to embed the app. X-Frame-Options mirrors 'self'/'none' automatically.
# FRAME_ANCESTORS='none'

# Extra hosts the CSRF Origin check accepts as "this deployment". Only needed
# when a proxy chain rewrites Host and sends no x-forwarded-host (the sandbox
# preview does exactly that), so genuine logins would otherwise arrive looking
# foreign and get 403-blocked. Comma-separated; an entry starting with a dot
# matches the whole suffix (cookie-Domain semantics). Unset by default — a
# deployment whose proxy preserves Host needs nothing here, and the
# foreign-Origin block is unchanged.
# CSRF_TRUSTED_HOSTS=.preview-platform.example

# Rate-limit knobs (in-memory, per process; defaults follow the spec) —
# override only if you know why:
#   login     5 failed attempts / phone / 15 min   (RATE_LIMIT_LOGIN_MAX)
#   login     20 attempts / IP / 15 min            (RATE_LIMIT_LOGIN_IP_MAX)
#   register  5 accounts / IP / hour               (RATE_LIMIT_REGISTER_MAX)
#   publish   20 listings / user / day             (RATE_LIMIT_PUBLISH_MAX)
#   upload    30 photos / user / hour              (RATE_LIMIT_UPLOAD_MAX)
#   reports   10 accepted / reporter / day (guest cap tunable below)
#   reset     3 codes / phone / hour + 10 / IP / hour
# The test suite salts a unique source IP per request, so these spec
# defaults hold in CI/dev with no headroom; the knobs stay for operators
# whose reverse proxies collapse client IPs (then EVERY request shares one
# bucket — raise the caps or restore real client IPs at the proxy).
# RATE_LIMIT_PUBLISH_MAX=40
# RATE_LIMIT_REPORT_IP_MAX=100
# RATE_LIMIT_RESET_IP_MAX=100

# Where buyers and hidden sellers send appeals (shown in moderation
# notifications). Set a real inbox before launch.
# SUPPORT_EMAIL=support@mudaala.app

# ---- SMS delivery (password reset codes) ----
# In development the console provider "delivers" each message to the dev
# server console — that printout is the developer's inbox. In production set
# ALL of the Africa's Talking values below; a failed send is logged (without
# the phone number or the code) and the user can request another code.
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=

# Optional: force the console SMS provider (reset codes print to the server
# console). For staging/self-test deployments that run NODE_ENV=production
# without real Africa's Talking credentials. Never set this in real production.
# SMS_PROVIDER=console

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudaala-rate-limit-prototype",
  "main": "scripts/rate-limit-prototype-worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMIT_SHARDS", "class_name": "RateLimitShard" }
    ]
  },
  "migrations": [
    { "tag": "v1-rate-limit-prototype", "new_sqlite_classes": ["RateLimitShard"] }
  ]
}

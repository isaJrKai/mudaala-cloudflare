{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudaala-concept-preview",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://mudaala.store",
    "NEXT_PUBLIC_APP_URL": "https://mudaala.store",
    "CONCEPT_PREVIEW_ONLY": "1",
    "DATABASE_URL": "postgresql://preview:preview@127.0.0.1:5432/preview",
    "CRON_SECRET": "preview-only-disabled-cron-secret",
    "SETTINGS_ENCRYPTION_KEY": "preview-only-not-a-real-encryption-key-000000",
    "ADMIN_USER_IDS": "preview-no-admin"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
